      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "surprised",
          "text": "¿JHONY? ¡LA CONCHA DE TU MADRE! ¡ESTÁS VIVO!"
        },
        {
          "speaker": "jhony",
          "expression": "annoyed",
          "text": "¿Y qué querés, boludo?"
        },
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¿Cómo que qué quiero? ¡Estamos atrapados en esta mierda!"
        },
        {
          "speaker": "jhony",
          "expression": "neutral",
          "text": "¿Y?"
        }
      ]
    },
    {
      "type": "animate",
      "actor": "jhony",
      "animation": "point",
      "duration": 1.2
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¡¿CÓMO QUE Y?! ¡TENEMOS QUE SALIR!"
        },
        {
          "speaker": "jhony",
          "expression": "angry",
          "text": "¡Bueno, salí entonces! ¡No me rompas las pelotas!"
        },
        {
          "speaker": "maxi-negro",
          "expression": "annoyed",
          "text": "¡Jhony, tenés más de dos mil horas en este juego! ¡Ayudame!"
        },
        {
          "speaker": "jhony",
          "expression": "angry",
          "text": "¡¿Y QUÉ TIENE QUE VER?! ¡ANDATE, PELOTUDO!"
        },
        {
          "speaker": "maxi-negro",
          "expression": "annoyed",
          "text": "Pero escuchame un segundo, boludo..."
        },
        {
          "speaker": "jhony",
          "expression": "angry",
          "text": "¡NO! ¡ME ESTÁS TRAYENDO TODOS LOS ZOMBIES, LA CONCHA DE TU MADRE!"
        }
      ]
    },
