      "corpse-b": [560, 562],
      "corpse-c": [700, 552],
      "corpse-d": [790, 540],
      "corpse-e": [980, 552],
      "corpse-f": [400, 538]
    },
    "actors": {
      "negro": { "character": "maxi-negro", "at": "entrance" },
      "jhony": { "character": "jhony", "at": "jhony" },
      "body-a": { "enemy": "zombie", "at": "corpse-a", "state": "dead" },
      "body-b": { "enemy": "zombie", "at": "corpse-b", "state": "dead" },
      "body-c": { "enemy": "runner", "at": "corpse-c", "state": "dead" },
      "body-d": { "enemy": "zombie", "at": "corpse-d", "state": "dead" },
      "body-e": { "enemy": "brute", "at": "corpse-e", "state": "dead" },
      "body-f": { "enemy": "zombie", "at": "corpse-f", "state": "dead" },
      "walker-a": { "enemy": "zombie", "at": "walker-far" },
      "walker-b": { "enemy": "zombie", "at": "walker-far" }
    }
  },
  "steps": [
    { "type": "parallel", "steps": [
      { "type": "move", "actor": "negro", "to": "meet", "duration": 1.6 },
      { "type": "camera", "to": "jhony", "zoom": 1.15, "duration": 1.6 }
    ] },
    { "type": "dialogue", "lines": [
      { "speaker": "maxi-negro", "expression": "surprised", "text": "¿JHONY? ¡LA CONCHA DE TU MADRE! ¡ESTÁS VIVO!" },
      { "speaker": "jhony", "expression": "annoyed", "text": "¿Y qué querés, boludo?" },
      { "speaker": "maxi-negro", "expression": "angry", "text": "¿Cómo que qué quiero? ¡Estamos atrapados en esta mierda!" },
      { "speaker": "jhony", "expression": "neutral", "text": "¿Y?" }
    ] },
    { "type": "parallel", "steps": [
      { "type": "move", "actor": "walker-a", "to": "walker-near", "duration": 1.8 },
      { "type": "animate", "actor": "jhony", "animation": "point", "duration": 1.8 }
    ] },
    { "type": "dialogue", "lines": [
      { "speaker": "maxi-negro", "expression": "angry", "text": "¡¿CÓMO QUE Y?! ¡TENEMOS QUE SALIR!" },
      { "speaker": "jhony", "expression": "angry", "text": "¡Bueno, salí entonces! ¡No me rompas las pelotas!" },
      { "speaker": "maxi-negro", "expression": "annoyed", "text": "¡Jhony, tenés más de dos mil horas en este juego! ¡Ayudame!" },
      { "speaker": "jhony", "expression": "angry", "text": "¡¿Y QUÉ TIENE QUE VER?! ¡ANDATE, PELOTUDO!" },
      { "speaker": "maxi-negro", "expression": "annoyed", "text": "Pero escuchame un segundo, boludo..." },
      { "speaker": "jhony", "expression": "angry", "text": "¡NO! ¡ME ESTÁS TRAYENDO TODOS LOS ZOMBIES, LA CONCHA DE TU MADRE!" }
    ] },
    { "type": "move", "actor": "walker-b", "to": "walker-near", "duration": 1.6 },
    { "type": "camera", "to": "corpse-c", "zoom": 1.25, "duration": 1.2 },
    { "type": "dialogue", "lines": [
      { "speaker": "maxi-negro", "expression": "neutral", "text": "Igual, Jhony, ¿no te parece que ya jugaste bastante a esta mierda?" },
      { "speaker": "jhony", "expression": "angry", "text": "¡Y A VOS QUÉ CARAJO TE IMPORTA!" }
    ] },
    { "type": "camera", "to": "meet", "zoom": 1.1, "duration": 1.1 },
    { "type": "dialogue", "lines": [
      { "speaker": "maxi-negro", "expression": "annoyed", "text": "Bueno, chupame un huevo. Me voy a buscar a los otros." },
      { "speaker": "jhony", "expression": "angry", "text": "¡BUENO, ANDÁ!" }
    ] },
    { "type": "move", "actor": "negro", "to": "entrance", "duration": 1.5 },
    { "type": "dialogue", "lines": [
      { "speaker": "jhony", "expression": "angry", "text": "¡Y NO ME TRAIGAS MÁS ZOMBIES!" }
    ] }
  ],
  "effects": [{ "key": "act-01-met-jhony", "value": true }]
}
