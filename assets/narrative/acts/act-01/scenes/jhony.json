      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Igual, Jhony, ¿no te parece que ya jugaste bastante a esta mierda?"
        },
        {
          "speaker": "jhony",
          "expression": "angry",
          "text": "¡Y A VOS QUÉ CARAJO TE IMPORTA! ¡VOS CAMBIÁS DE JUEGO CADA DOS DÍAS PORQUE SOS MALO EN TODO!"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "annoyed",
          "text": "Bueno, chupame la pija. Me voy a buscar a los otros."
        },
        {
          "speaker": "jhony",
          "expression": "angry",
          "text": "¡BUENO, ANDÁ!"
        }
      ]
