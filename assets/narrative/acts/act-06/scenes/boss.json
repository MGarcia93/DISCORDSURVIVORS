      "duration": 0.4
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "papafrita",
          "expression": "neutral",
          "text": "Bueno, ahora escuchen lo que les voy a decir para que no vuelva a pasar—"
