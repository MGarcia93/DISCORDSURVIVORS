    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "papafrita",
          "expression": "neutral",
          "text": "Como les decía—"
        }
      ]
    },
    {
      "type": "notice",
      "title": "RATHALOS",
      "lines": [
        "¡ROAAAAAR!"
      ],
      "duration": 2.2
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "¡JAJAJAJA! ¡HASTA EL DRAGÓN QUIERE QUE CIERRES EL ORTO!"
        },
        {
          "speaker": "papafrita",
          "expression": "annoyed",
          "text": "Y no es un dragón, es un wyvern. Los dragones tienen cuatro patas y—"
        }
      ]
    },
    {
      "type": "notice",
      "title": "RATHALOS",
      "lines": [
        "¡ROAAAAAR!"
      ],
      "duration": 2.2
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "papafrita",
          "expression": "angry",
          "text": "¡LA CONCHA DE TU MADRE!"
        },
        {
          "speaker": "papafrita",
          "expression": "angry",
          "text": "Escuchame una cosa, dragón de mierda."
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "papafrita",
          "expression": "neutral",
          "text": "Bueno. Como les decía, este bicho tiene tres fases y—"
        },
        {
          "speaker": "maxi-negro",
          "expression": "annoyed",
          "text": "No, boludo. Ya fue."
        },
        {
          "speaker": "papafrita",
          "expression": "neutral",
          "text": "—y además el fuego sigue un patrón que—"
        },
        {
          "speaker": "solago",
          "expression": "angry",
          "text": "¡QUE ARRANQUE LA PELEA DE UNA VEZ!"
