        {
          "speaker": "papafrita",
          "expression": "angry",
          "text": "¡PERO WARRIOR! ¡TE DIJE QUE ESPERARAS, HIJO DE PUTA!"
        },
        {
          "speaker": "warrior",
          "expression": "angry",
          "text": "¡DALE, MANCO! ¡NO SE TIRARON, URA!"
        },
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "¡JAJAJAJA! ¡PERO SI DIJISTE QUE SÍ, PELOTUDO!"
        },
        {
          "speaker": "warrior",
          "expression": "angry",
          "text": "¡Y BUENO, URA! ¡SI ME SEGUÍAN LO HACÍAMOS MIERDA!"
        },
        {
          "speaker": "papafrita",
          "expression": "angry",
          "text": "¡PERO SI TODAVÍA NO TE DIJE QUE FUERAS!"
        },
        {
          "speaker": "warrior",
          "expression": "angry",
          "text": "¡DALE, MANCO!"
        },
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "JAJAJAJA. ¡EL HIJO DE PUTA SE MANDÓ SOLO Y NOS ECHA LA CULPA!"
        }
      ]
    },
    {
      "type": "move",
      "actor": "warrior",
