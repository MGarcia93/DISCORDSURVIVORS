      "lines": [
        {
          "speaker": "papafrita",
          "expression": "neutral",
          "text": "Bueno, cuidado acá. El Pukei-Pukei puede envenenarlos y también tiene ataques con la lengua."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Bueno, esquivamos el veneno."
        },
        {
          "speaker": "papafrita",
          "expression": "neutral",
          "text": "Sí, pero hay otra cosa que tienen que saber."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "No."
        },
        {
          "speaker": "papafrita",
          "expression": "neutral",
          "text": "¿Y sabés qué más?"
        },
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¡NO QUIERO SABER QUÉ MÁS!"
        },
        {
          "speaker": "papafrita",
          "expression": "angry",
          "text": "¡QUE TAMBIÉN ESCUPE VENENO A DISTANCIA!"
        },
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¡LO ESTOY VIENDO, PELOTUDO!"
        }
      ]
    }
  ]
