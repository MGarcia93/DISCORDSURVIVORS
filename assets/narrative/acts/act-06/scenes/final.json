    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "papafrita-casual",
          "expression": "surprised",
          "text": "¿Eh? ¡PARÁ, QUE NO TERMINÉ!"
        },
        {
          "speaker": "papafrita-casual",
          "expression": "angry",
          "text": "¡MAXI, LA CONCHA DE TU MADRE! ¡ME FALTABA PROBAR LA ARMADURA!"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Me tenés los huevos llenos."
        },
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "JAJAJAJA. ¡LO BANEARON POR ROMPEBOLAS!"
        },
        {
          "speaker": "papafrita-casual",
          "expression": "angry",
          "text": "¡Pero si estaba explicando una cosa!"
        },
        {
          "speaker": "solago",
          "expression": "angry",
          "text": "¡POR ESO MISMO, PELOTUDO!"
        },
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "Bueno, por lo menos ya estamos todos acá."
        },
        {
          "speaker": "warrior",
          "expression": "neutral",
          "text": "Falta Jhony, ura."
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Sí, después vemos al otro."
        }
      ]
    },
    {
      "type": "notice",
      "title": "SERVIDOR",
      "duration": 3.5,
      "lines": [
        "JHONY — PROJECT_ZOMBOID — CONECTADO",
        "MONSTER_HUNTER_WORLD_OLD — 0 USUARIOS"
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "papafrita-casual",
          "expression": "neutral",
          "text": "Che, Negro."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "¿Qué?"
        },
        {
          "speaker": "papafrita-casual",
          "expression": "neutral",
          "text": "¿Mañana jugamos al Monster Hunter?"
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "¿No que querías jugar solo?"
        },
        {
          "speaker": "papafrita-casual",
          "expression": "neutral",
          "text": "Necesito farmear otra armadura."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Ahhh, ¿así que querés jugar conmigo?"
        },
        {
          "speaker": "papafrita-casual",
          "expression": "neutral",
          "text": "No, Negro. Necesito alguien que me ayude."
        },
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "JAJAJAJA. Dale, hijo de puta. Tipo nueve."
        },
        {
          "speaker": "papafrita-casual",
          "expression": "happy",
          "text": "Dale, Negro. Te quiero."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Yo también, pelotudo."
        },
        {
          "speaker": "papafrita-casual",
          "expression": "neutral",
          "text": "Igual no llegues tarde."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Chupame bien la pija."
        }
      ]
    },
    {
      "type": "notice",
      "title": "PAPAFRITA DESBLOQUEADO",
      "duration": 4.5,
      "lines": [
        "«Habla mucho. Demasiado. Por suerte ahora hace daño»."
      ]
    }
  ]
