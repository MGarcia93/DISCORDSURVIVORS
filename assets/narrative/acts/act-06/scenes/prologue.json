          "speaker": "solago",
          "expression": "neutral",
          "text": "¿Dos qué?"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Dos boludos."
        },
        {
          "speaker": "warrior",
          "expression": "neutral",
          "text": "¿Y quiénes son, ura?"
        }
