    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Ah, Jhony sigue matando zombis."
        },
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "Y sí, estaba bastante tranquilo ahí."
        },
        {
          "speaker": "solago",
          "expression": "neutral",
          "text": "¿Y Papafrita?"
        },
        {
          "speaker": "maxi-negro",
          "expression": "disgusted",
          "text": "¡PUAJ!"
        },
        {
          "speaker": "solago",
          "expression": "disgusted",
          "text": "Sí, que se quede ahí."
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "A Papafrita ya le abrí un portal para volver."
        },
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "¿Y no quiso salir?"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "No. Me mandó como mil mensajes."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "¿Y qué te decía?"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Que estaba terminando una armadura. Lo tuve que bloquear."
        }
      ]
    },
    {
      "type": "notice",
      "title": "CHAT PRIVADO",
      "duration": 5,
      "lines": [
        "MAXI: che salí del mundo que ya terminamos",
        "PAPAFRITA: para que estoy terminando una armadura",
        "MAXI: dale boludo",
        "PAPAFRITA: igual hay una cosa que no entiendo",
        "PAPAFRITA: porque en realidad el sistema de afinidad",
        "PAPAFRITA: funciona distinto dependiendo del arma",
        "PAPAFRITA: y sabés qué más",
        "MAXI: PAPAFRITA SALÍ",
        "PAPAFRITA: para que te explico"
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "JAJAJAJA. ¡EL HIJO DE PUTA TE ESTÁ EXPLICANDO EL MONSTER HUNTER!"
        },
        {
          "speaker": "solago",
          "expression": "neutral",
          "text": "Bueno, dejalo. Está feliz."
        },
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "Y sí, si quiere quedarse, que siga jugando."
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "No puedo cerrar el juego con él adentro."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "¿Y qué hacemos? ¿Lo dejamos abierto para siempre?"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Y bueno..."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Che, ¿qué hacés?"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Nada."
