          "text": "Pará... ¿Solago?"
        },
        {
          "speaker": "solago",
          "expression": "angry",
          "text": "¡NEGRO! ¡SACAME DE ACÁ, LA CONCHA DE TU MADRE!"
        },
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "JAJAJA. ¡¿QUÉ MIERDA HACÉS CON YORICK?!"
        },
        {
          "speaker": "solago",
          "expression": "angry",
          "text": "¡ESTE PELOTUDO PIENSA QUE SOY UNO DE SUS BICHOS!"
