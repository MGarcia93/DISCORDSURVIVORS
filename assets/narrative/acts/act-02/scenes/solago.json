    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "yorick",
          "expression": "angry",
          "text": "¿Quién perturba a mis caminantes?"
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Amigo, ese no es un caminante. Es Solago."
        },
        {
          "speaker": "yorick",
          "expression": "surprised",
          "text": "¿Solago? Curioso nombre para una criatura tan pequeña."
        },
        {
          "speaker": "solago",
          "expression": "angry",
          "text": "¡NO SOY UNA CRIATURA, HIJO DE PUTA!"
        },
        {
          "speaker": "yorick",
          "expression": "tired",
          "text": "Mi pequeño caminante siempre ha sido bastante temperamental."
        },
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "JAJAJA. Y bueno, Solago, si sos igual a los otros."
        },
        {
          "speaker": "solago",
          "expression": "angry",
          "text": "¡NEGRO, DEJÁ DE CAGARTE DE RISA Y AYUDAME!"
        }
      ]
    },
