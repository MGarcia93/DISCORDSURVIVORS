      "type": "dialogue",
      "lines": [
        {
          "speaker": "lilith",
          "expression": "neutral",
          "text": "Hijos míos. Llegaron hasta acá."
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "surprised",
          "text": "¿Hijos? Yo tengo madre, gracias."
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "lilith",
          "expression": "neutral",
          "text": "Ella también me sirvió."
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "solago",
          "expression": "scared",
          "text": "Negro, esa mina no me gusta."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "¿Qué te hace ruido?"
        },
        {
          "speaker": "solago",
          "expression": "annoyed",
          "text": "Que tiene cuernos y no está en un cumpleaños."
        },
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "Y una espada carísima."
        },
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¡PAPASITO, POR UNA VEZ EN TU VIDA, NO!"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "lilith",
          "expression": "angry",
          "text": "El infierno los reclama."
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "solago",
          "expression": "angry",
          "text": "¡NOSOTROS RECLAMAMOS UNA SALIDA, LA CONCHA DE TU MADRE!"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "lilith",
          "expression": "angry",
          "text": "Entonces sáquenla de mi mano."
        }
      ]
    }
