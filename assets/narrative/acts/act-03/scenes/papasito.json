  "steps": [
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "¡PAPASITO!"
        },
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¡PAPASITO, BOLUDO! ¡TE ESTOY HABLANDO!"
        },
        {
          "speaker": "solago",
          "expression": "annoyed",
          "text": "Che, negro, dejá. Este hijo de puta no va a contestar."
        },
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¡EH, PARAGUAYO! ¡TENEMOS QUE SALIR DE ACÁ!"
        },
        {
          "speaker": "solago",
          "expression": "happy",
          "text": "Pará, ya sé cómo hacerlo venir."
        },
        {
          "speaker": "solago",
          "expression": "happy",
          "text": "¡PAPASITO! ¡ESTAMOS CON TOMI!"
        }
      ]
    },
    {
      "type": "move",
      "actor": "papasito",
      "to": "papasito",
      "duration": 1.1
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "papasito",
          "expression": "surprised",
          "text": "¿Tomi? ¿Dónde?"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "JAJAJA. ¡MIRÁ CÓMO APARECIÓ EL HIJO DE PUTA!"
        },
        {
          "speaker": "solago",
          "expression": "happy",
          "text": "¡A VER SI AHORA VENÍS, QUE SE TE MOJA LA TANGA CADA VEZ QUE HABLAMOS DE TU MACHO!"
        },
        {
          "speaker": "papasito",
          "expression": "angry",
          "text": "¡DEJEN DE JODER! ¿DÓNDE ESTÁ TOMI?"
        },
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "¡JAJAJA! ¡NO ESTÁ, PARAGUAYO! ¡TE HICIMOS VENIR!"
        },
        {
          "speaker": "papasito",
          "expression": "angry",
          "text": "¡LA PUTA MADRE!"
        },
        {
          "speaker": "solago",
          "expression": "happy",
          "text": "¡JAJAJA! ¡TE ESTAMOS LLAMANDO HACE MEDIA HORA Y APENAS NOMBRAMOS A TU MACHO APARECÉS!"
        },
        {
          "speaker": "papasito",
          "expression": "angry",
          "text": "¡YO VINE POR EL LOOT, CARAJO!"
        },
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "Sí, sí, el loot de Tomi, JAJAJA."
        },
        {
          "speaker": "papasito",
          "expression": "angry",
          "text": "¡DEJEN DE ROMPER LAS PELOTAS!"
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Bueno, escuchame. ¡Estamos atrapados en los juegos y tenemos que encontrar la salida!"
        },
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "Ah, sí."
        },
        {
          "speaker": "solago",
          "expression": "annoyed",
          "text": "¿Cómo que ah, sí?"
        },
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "Ya sé."
        },
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¿Y QUÉ HACÉS ACÁ?"
        },
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "Farmeando."
        },
        {
          "speaker": "maxi-negro",
          "expression": "tired",
          "text": "La concha de tu madre..."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Bueno, dale, vení con nosotros."
        },
        {
          "speaker": "solago",
          "expression": "happy",
          "text": "¡CHE, QUE TOMI NOS ESTÁ ESPERANDO!"
        },
        {
          "speaker": "papasito",
          "expression": "angry",
          "text": "¡YA VOY, CARAJO!"
        },
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "JAJAJA. No puede ser, boludo."
        },
        {
          "speaker": "solago",
          "expression": "happy",
          "text": "¡JAJAJA! ¡QUÉ ENAMORADO ESTÁ EL PARAGUAYO!"
        },
        {
          "speaker": "papasito",
          "expression": "angry",
          "text": "¡CALLATE, CARAJO!"
        }
      ]
    },
    {
      "type": "notice",
      "title": "DISCORD SURVIVORS",
      "duration": 4,
      "lines": [
        "¡PAPASITO DESBLOQUEADO!",
        "Disponible para seleccionar en las próximas partidas."
      ]
    }
