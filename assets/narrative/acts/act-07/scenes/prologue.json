      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Bueno. Uno menos."
        },
        {
          "speaker": "solago",
          "expression": "neutral",
          "text": "¿Uno menos? ¡Si Maxi lo tuvo que sacar a la fuerza!"
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Y bueno, pero volvió. Cuenta."
        },
        {
          "speaker": "papafrita-casual",
          "expression": "annoyed",
          "text": "Volví expulsado, es distinto."
        },
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "Por lo menos ya estamos todos."
        },
        {
          "speaker": "warrior",
          "expression": "neutral",
          "text": "Falta Jhony."
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "..."
        },
        {
          "speaker": "maxi-negro",
          "expression": "surprised",
          "text": "Uh."
        },
        {
          "speaker": "solago",
          "expression": "neutral",
          "text": "¿Recién te acordás?"
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Yo pensé que había vuelto."
        }
      ]
    },
    {
      "type": "sound",
      "sound": "alert"
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "No."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "¿Sigue en el Project Zomboid?"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Sí."
        },
        {
          "speaker": "solago",
          "expression": "neutral",
          "text": "¿Desde el primer mundo?"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Sí."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "..."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Bueno, tampoco pasó tanto."
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Para él sí."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Che, ¿y le mandaste mensaje?"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Sí."
        },
        {
          "speaker": "solago",
          "expression": "neutral",
          "text": "¿Y qué dijo?"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Nada. Ya saben cómo es Jhony, no mira los mensajes."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Bueno, sacalo como hiciste con Papafrita."
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Dale."
        }
      ]
    },
