      "lines": [
        {
          "speaker": "solago",
          "expression": "surprised",
          "text": "A la mierda."
        },
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "Qué grande es esto."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "¿Vos hiciste toda esta base?"
        },
        {
          "speaker": "jhony",
          "expression": "neutral",
          "text": "Sí."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Qué enfermo de mierda."
        },
        {
          "speaker": "jhony",
          "expression": "annoyed",
          "text": "¿Qué querés? ¿Que me quede parado como un pelotudo?"
        },
        {
          "speaker": "solago",
          "expression": "neutral",
          "text": "Igual, alta base te mandaste."
        },
        {
          "speaker": "jhony",
          "expression": "neutral",
          "text": "Y sí. Me vi unas guías, armé una buena build, limpié toda la zona..."
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "papafrita-casual",
          "expression": "neutral",
          "text": "Igual, Negro, vos no toqués nada acá."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "¿Por qué?"
        },
        {
          "speaker": "papafrita-casual",
          "expression": "neutral",
          "text": "Porque después pasa lo mismo que cuando activé el PvP sin querer."
        },
        {
          "speaker": "solago",
          "expression": "neutral",
          "text": "¿Qué pasó?"
        },
        {
          "speaker": "maxi-negro",
          "expression": "annoyed",
          "text": "Me cagó matando el hijo de puta."
        },
        {
          "speaker": "papafrita-casual",
          "expression": "angry",
          "text": "¡PERO FUE SIN QUERER!"
        },
        {
          "speaker": "jhony",
          "expression": "happy",
          "text": "JAJAJA, me acuerdo."
        },
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¡Me pisó la cabeza, boludo!"
        },
        {
          "speaker": "papafrita-casual",
          "expression": "angry",
          "text": "¡¿Y CÓMO IBA A SABER QUE TE MORÍAS DE UN PISOTÓN EN LA CABEZA?!"
        },
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¡¿CÓMO QUE NO?! ¡SI MI PERSONAJE ESTABA RE DÉBIL! ¡POR ESO ESTUVE TODO EL TIEMPO EN LA BASE!"
        },
        {
          "speaker": "jhony",
          "expression": "happy",
          "text": "JAJAJAJA."
        },
        {
          "speaker": "papafrita-casual",
          "expression": "annoyed",
          "text": "Bueno, yo qué sabía que te iba a matar."
        },
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¡Y ENCIMA TENÍAS EL PVP ACTIVADO, PELOTUDO!"
        },
        {
          "speaker": "papafrita-casual",
          "expression": "angry",
          "text": "¡QUE FUE SIN QUERER, BOLUDO!"
        }
      ]
    },
