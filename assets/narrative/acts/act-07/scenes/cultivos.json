    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Che, ¿tenés gallinas?"
        },
        {
          "speaker": "jhony",
          "expression": "neutral",
          "text": "Sí. ¿Por?"
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "No dejes que Papafrita se acerque."
        },
        {
          "speaker": "papafrita-casual",
          "expression": "annoyed",
          "text": "Dale, Negro, no empecés."
        },
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "¿Qué pasó con las gallinas?"
        },
        {
          "speaker": "jhony",
          "expression": "happy",
          "text": "JAJAJA, no, la gallina..."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Tres horas, boludo. TRES HORAS buscando una gallina."
        },
        {
          "speaker": "papafrita-casual",
          "expression": "neutral",
          "text": "Bueno, pero..."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "La llevo a la base, la dejo ahí, viene este pelotudo, le pega una sola vez y la mata."
        },
        {
          "speaker": "jhony",
          "expression": "happy",
          "text": "JAJAJAJA."
        },
        {
          "speaker": "papafrita-casual",
          "expression": "angry",
          "text": "¡PERO NO PENSÉ QUE SE IBA A MORIR DE UN GOLPE!"
        },
        {
          "speaker": "jhony",
          "expression": "angry",
          "text": "¡Y ME DEJASTE TODA LA BASE LLENA DE SANGRE, HIJO DE PUTA!"
        },
        {
          "speaker": "papafrita-casual",
          "expression": "angry",
          "text": "¡PERO ME HICISTE LIMPIARLA!"
        },
        {
          "speaker": "jhony",
          "expression": "annoyed",
          "text": "Papafrita, no toqués las gallinas."
        },
        {
          "speaker": "papafrita-casual",
          "expression": "neutral",
          "text": "Bueno, tampoco iba a tocar ninguna."
        }
      ]
    }
  ]
