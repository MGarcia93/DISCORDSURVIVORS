    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "¡JAJAJA! ¡NOOO! ¡EL BOT TAMPOCO TE CREE QUE SOS ARGENTINO!"
        },
        {
          "speaker": "solago",
          "expression": "happy",
          "text": "¡JAJAJA! ¡TE DEPORTÓ A CONAN, HIJO DE PUTA!"
        },
        {
          "speaker": "warrior",
          "expression": "angry",
          "text": "¡QUE SOY ARGENTINO, LA CONCHA DE SU MADRE!"
        }
      ]
    },
    {
      "type": "notice",
      "title": "ADMINISTRADOR",
      "duration": 3,
      "lines": [
        "Reclamo rechazado. Nacionalidad no verificada."
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "¡JAJAJA! ¡PERO SI JUJUY ESTÁ EN ARGENTINA, BOT PELOTUDO!"
        }
      ]
    },
    {
      "type": "notice",
      "title": "ADMINISTRADOR",
      "duration": 3,
      "lines": [
        "Error geográfico reconocido. Corrección pospuesta."
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "solago",
          "expression": "happy",
          "text": "¡JAJAJA! ¡LO MANDARON A CUALQUIER LADO POR BOLIVIANO!"
        },
        {
          "speaker": "warrior",
          "expression": "angry",
          "text": "¡SOY DE JUJUY, HIJO DE PUTA!"
        },
        {
          "speaker": "maxi-negro",
          "expression": "tired",
          "text": "Sí, sí, ya sabemos, Warrior."
        }
      ]
    },
    {
      "type": "camera",
      "to": "guard",
