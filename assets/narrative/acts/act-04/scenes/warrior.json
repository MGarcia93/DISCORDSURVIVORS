    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "esclavista",
          "expression": "neutral",
          "text": "¡APÁRTENSE DE MI PRISIONERO!"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "annoyed",
          "text": "Pará, flaco. ¿Por qué carajo lo tienen encerrado?"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "esclavista",
          "expression": "angry",
          "text": "Lo encontramos vagando por el desierto y lo trajimos al campamento."
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "solago",
          "expression": "neutral",
          "text": "¿Y por qué?"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "esclavista",
          "expression": "neutral",
          "text": "¡POR LOS OJOS ROJOS Y EL OLOR A HIERBA! ¡APESTABA TODO EL CAMPAMENTO!"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "¡JAJAJA! ¡TE RASTREARON POR EL OLOR, HIJO DE PUTA!"
        },
        {
          "speaker": "warrior",
          "expression": "angry",
          "text": "¡SÁQUENME DE ACÁ, LA PUTA MADRE!"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "esclavista",
          "expression": "angry",
          "text": "¡NO LO SOLTAREMOS!"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "solago",
          "expression": "happy",
          "text": "JAJAJA. ¡Y ENCIMA ES BOLIVIANO!"
        },
        {
          "speaker": "warrior",
          "expression": "angry",
          "text": "¡QUE NO SOY BOLIVIANO!"
        }
      ]
    },
    {
      "type": "notice",
      "title": "ADMINISTRADOR",
      "duration": 3,
      "lines": [
        "Nacionalidad declarada no verificada."
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¡CERRÁ EL ORTO, BOT DE MIERDA!"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "esclavista",
          "expression": "angry",
          "text": "¡CAPTÚRENLOS! ¡TENEMOS TRES ESCLAVOS MÁS!"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "scared",
          "text": "¡NOOO! ¡LA CONCHA DE TU MADRE! ¡YA SUELTEN AL BOLIVIANO Y NOS VAMOS!"
        },
        {
          "speaker": "warrior",
          "expression": "angry",
          "text": "¡ARGENTINO, HIJO DE PUTA!"
        }
      ]
