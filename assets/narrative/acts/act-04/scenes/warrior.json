      "lines": [
        {
          "speaker": "solago",
          "expression": "happy",
          "text": "¡JAJAJA! ¡NOOO! ¡¿QUÉ HACE ESTE PELOTUDO ACÁ?!"
        },
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "¡PERO SI VOS NO JUGASTE CONAN EN TU PUTA VIDA!"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "warrior",
          "expression": "neutral",
          "text": "Me mandó el bot, ura."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Hablá más fuerte, Warrior."
        },
        {
          "speaker": "warrior",
          "expression": "annoyed",
          "text": "¡QUE ME MANDÓ EL BOT!"
        }
      ]
    },
    {
      "type": "camera",
      "to": "overview",
      "zoom": 1.1,
      "duration": 0.7
    },
    {
      "type": "sound",
      "sound": "alert"
