    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "tired",
          "text": "No, flaco. Habla así."
        },
        {
          "speaker": "solago",
          "expression": "happy",
          "text": "JAJAJA. ¡Y ENCIMA ES BOLIVIANO!"
        },
        {
          "speaker": "warrior",
          "expression": "angry",
          "text": "¡QUE NO SOY BOLIVIANO!"
