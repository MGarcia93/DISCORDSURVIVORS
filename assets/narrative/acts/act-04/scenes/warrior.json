    {
      "type": "notice",
      "title": "ADMINISTRADOR DEL SERVIDOR",
      "duration": 6,
      "lines": [
        "Usuario: Warrior",
        "Nacionalidad declarada: Argentina",
        "Procedencia: Jujuy",
        "Nacionalidad estimada: Bolivia",
        "ERROR: DATOS CONTRADICTORIOS",
        "Juego compatible no encontrado.",
        "Destino asignado aleatoriamente: CONAN EXILES."
