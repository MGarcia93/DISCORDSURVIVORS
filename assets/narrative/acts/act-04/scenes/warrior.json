        {
          "speaker": "solago",
          "expression": "happy",
          "text": "¡JAJAJA! ¡NOOO! ¡LO METIERON A LABURAR PORQUE NO SE LE ENTIENDE!"
        },
        {
          "speaker": "warrior",
          "expression": "angry",
          "text": "¡SÁQUENME DE ACÁ, LA PUTA MADRE!"
