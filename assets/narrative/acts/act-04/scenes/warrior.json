      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "esclavista",
          "expression": "angry",
          "text": "¡¿VEN?! ¡SIGUE HABLANDO EN UNA LENGUA DESCONOCIDA!"
        }
