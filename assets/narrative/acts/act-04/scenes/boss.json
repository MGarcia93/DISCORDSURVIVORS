      "lines": [
        {
          "speaker": "taskmaster",
          "expression": "angry",
          "text": "¡NADIE ROBA MIS ESCLAVOS!"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¡LA CONCHA DE TU MADRE! ¡OTRO MÁS!"
        }
      ]
    },
    {
      "type": "move",
      "actor": "capataz",
      "to": "boss",
      "duration": 1.4
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "taskmaster",
          "expression": "angry",
          "text": "¡DEVUÉLVANME AL PRISIONERO!"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "solago",
          "expression": "neutral",
          "text": "¿Cuál de todos?"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "taskmaster",
          "expression": "angry",
          "text": "¡EL EXTRANJERO DE LOS OJOS ROJOS!"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "¡JAJAJA! ¡WARRIOR, TE VINIERON A BUSCAR!"
        },
        {
          "speaker": "warrior",
          "expression": "angry",
          "text": "¡NO VUELVO A ESA MIERDA!"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "taskmaster",
          "expression": "angry",
          "text": "¡PERTENECE A MI CAMPAMENTO!"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "solago",
          "expression": "happy",
          "text": "¡JAJAJA! ¡DEVOLVÉLO, NEGRO! ¡TODAVÍA TIENE QUE TERMINAR LA OBRA!"
        },
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "..."
        },
        {
          "speaker": "maxi-negro",
          "expression": "surprised",
          "text": "¡PARÁ! ¡EL ALBAÑIL ES PAPASITO!"
        },
        {
          "speaker": "papasito",
          "expression": "angry",
          "text": "¡QUE NO SOY ALBAÑIL, CARAJO!"
        },
        {
          "speaker": "solago",
          "expression": "happy",
          "text": "JAJAJA. ¡TENEMOS DOS ESCLAVOS Y NINGUNO QUIERE LABURAR!"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "taskmaster",
          "expression": "angry",
          "text": "¡LOS CUATRO TRABAJARÁN PARA MÍ!"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¡NO, FLACO! ¡YO ESTOY DE VACACIONES!"
        }
      ]
    },
