    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¡SÍ, LA CONCHA DE TU MADRE!"
        },
        {
          "speaker": "solago",
          "expression": "angry",
          "text": "¡SÍ!"
        },
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "Sí."
        },
        {
          "speaker": "warrior",
          "expression": "angry",
          "text": "¡SÍ!"
        }
      ]
    },
    {
      "type": "notice",
      "title": "ADMINISTRADOR",
      "duration": 5,
      "lines": [
        "Voto a favor de omitir Monster Hunter.",
        "Decisión unánime. Monster Hunter omitido."
