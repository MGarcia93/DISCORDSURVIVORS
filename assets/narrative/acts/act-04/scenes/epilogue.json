    {
      "type": "notice",
      "title": "TODOS",
      "duration": 3,
      "lines": [
        "¡PUAAAAAJ!"
      ]
    },
    {
      "type": "notice",
      "title": "ADMINISTRADOR",
      "duration": 4,
      "lines": [
