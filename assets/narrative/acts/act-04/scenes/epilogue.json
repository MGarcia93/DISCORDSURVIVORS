    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "surprised",
          "text": "Pará, boludo. ¿Y los otros?"
        },
        {
          "speaker": "solago",
          "expression": "neutral",
          "text": "Jhony se quedó matando zombies, el hijo de puta."
        },
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "¿Y Maxi?"
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Ni idea, Papasito. No apareció en ninguno de los juegos."
        },
        {
          "speaker": "warrior",
          "expression": "surprised",
          "text": "¿Y PAPAFRITA?"
        }
      ]
    },
    {
      "type": "notice",
      "title": "ADMINISTRADOR",
      "duration": 4,
      "lines": [
        "Usuario Papafrita localizado.",
