    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¡ME CHUPA UN HUEVO! ¡NO PIENSO ESCUCHAR A ESE HIJO DE PUTA!"
        },
        {
          "speaker": "solago",
          "expression": "scared",
          "text": "¡NEGRO, SI ENTRAMOS AHÍ NO SALIMOS MÁS!"
