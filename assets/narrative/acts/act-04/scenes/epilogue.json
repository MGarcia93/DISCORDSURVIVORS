        {
          "speaker": "solago",
          "expression": "happy",
          "text": "¡LE DIO ASCO AL ADMINISTRADOR, LA CONCHA DE TU MADRE!"
        },
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "Ya está. Saltalo."
        },
        {
          "speaker": "warrior",
          "expression": "angry",
          "text": "¡SACALO A LA MIERDA!"
        }
      ]
    },
    {
      "type": "notice",
      "title": "ADMINISTRADOR",
      "duration": 4,
      "lines": [
        "Confirmado. Usuario insoportable."
      ]
    },
    {
      "type": "splash",
      "speaker": "papafrita",
      "text": "...porque después, si quieren, les explico también las diferencias con Portable 3rd...",
      "duration": 5
    },
    {
      "type": "notice",
      "title": "TODOS",
      "duration": 3,
      "lines": [
        "¡PUAAAAAJ!"
      ]
    },
