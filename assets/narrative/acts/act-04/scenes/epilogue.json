    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "¡JAJAJA! ¡AL FIN UNA DECISIÓN INTELIGENTE DE ESTE BOT DE MIERDA!"
