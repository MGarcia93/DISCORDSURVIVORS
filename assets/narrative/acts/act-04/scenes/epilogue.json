      "type": "notice",
      "title": "TODOS",
      "duration": 3,
      "lines": [
        "¡PUAAAAAJ!"
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "disgusted",
          "text": "¡NO, LA CONCHA DE TU MADRE! ¡PAPAFRITA NO!"
        },
        {
          "speaker": "solago",
          "expression": "disgusted",
          "text": "¡NOOO! ¡A ESE NO LO QUIERO ESCUCHAR!"
        },
        {
          "speaker": "papasito",
          "expression": "disgusted",
          "text": "¡NI EN PEDO, CARAJO!"
        }
      ],
      "expressions": {
        "maxi-negro": "disgusted",
        "solago": "disgusted",
        "papasito": "disgusted"
      }
    },
    {
      "type": "notice",
      "title": "ADMINISTRADOR",
      "duration": 4,
      "lines": [
