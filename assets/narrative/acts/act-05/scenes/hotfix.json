    { "type": "notice", "title": "ADMINISTRADOR", "duration": 4, "lines": ["No es un error. Es una característica."] },
    {
      "type": "dialogue",
      "lines": [
        { "speaker": "maxi-negro", "expression": "angry", "text": "¡LA CONCHA DE TU MADRE!" }
