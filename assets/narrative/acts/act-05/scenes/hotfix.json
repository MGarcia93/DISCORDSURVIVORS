    {
      "type": "dialogue",
      "lines": [
        { "speaker": "papasito", "expression": "neutral", "text": "Esto ya está funcionando mal, ¿verdad?" },
        { "speaker": "maxi-negro", "expression": "angry", "text": "¡Y SÍ, PAPASITO! ¡LO PROGRAMARON CON LAS PATAS!" }
