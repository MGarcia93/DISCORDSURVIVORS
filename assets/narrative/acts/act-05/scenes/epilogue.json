    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Bueno, ¿qué onda? ¿Les gustó el jueguito?"
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "..."
        },
        {
          "speaker": "solago",
          "expression": "neutral",
          "text": "..."
        },
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "..."
        },
        {
          "speaker": "warrior",
          "expression": "neutral",
          "text": "..."
        },
        {
          "speaker": "maxi-negro",
          "expression": "surprised",
          "text": "Pará... ¿MAXI?"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "¿Qué pasa, negro?"
        },
        {
          "speaker": "solago",
          "expression": "angry",
          "text": "¡¿Y VOS DÓNDE MIERDA ESTABAS?!"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Acá, boludo."
        },
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¡¿CÓMO QUE ACÁ?!"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "¿Qué? ¿No se divirtieron?"
        },
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¡PARÁ, HIJO DE PUTA! ¡¿VOS SABÍAS TODO LO QUE ESTABA PASANDO?!"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Y sí, Negro."
        },
        {
          "speaker": "solago",
          "expression": "surprised",
          "text": "¡¿CÓMO QUE SÍ?!"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "¿Quién te pensás que programó todo eso?"
        }
      ]
    },
    {
      "type": "camera",
      "to": "maxi-close",
      "zoom": 1.1,
      "duration": 1
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "..."
        },
        {
          "speaker": "solago",
          "expression": "neutral",
          "text": "..."
        },
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "..."
        },
        {
          "speaker": "warrior",
          "expression": "neutral",
          "text": "..."
        },
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¡NOOOOO! ¡LA CONCHA DE TU MADRE!"
        },
        {
          "speaker": "solago",
          "expression": "angry",
          "text": "¡¿VOS HICISTE TODO ESTO, HIJO DE PUTA?!"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Y sí, boludos."
        },
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¡PERO POR QUÉ MIERDA NOS METISTE EN TODOS ESOS JUEGOS!"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Hace tres horas que rompen las pelotas con qué jugar y no se ponen de acuerdo."
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Les armé uno para todos y listo."
        },
        {
          "speaker": "solago",
          "expression": "angry",
          "text": "¡PERO CASI NOS MATAN, PELOTUDO!"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Bueno, pero jugaron juntos, ¿o no?"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Listo. Funcionó."
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "surprised",
          "text": "Pará, pará. ¿Y el Administrador ese de mierda?"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Era un bot que hice para manejar toda la partida. Parece que se fue un poquito al carajo."
        },
        {
          "speaker": "maxi-negro",
          "expression": "angry",
          "text": "¡PERO ERA UN HIJO DE PUTA!"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Y... aprendió de ustedes. Mirá cómo terminó."
        },
        {
          "speaker": "solago",
          "expression": "angry",
          "text": "¡¿Y POR QUÉ YORICK ME TENÍA DE MURGANEO?!"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Y, Solago... sos petiso, dientudo y jugás Yorick. Me la dejaste servida."
        },
        {
          "speaker": "solago",
          "expression": "angry",
          "text": "¡LA CONCHA DE TU MADRE!"
        },
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "¡JAJAJA! ¡ENCIMA LO HIZO A PROPÓSITO!"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Igual lo de tu jermu me dio más risa que el jefe."
        },
        {
          "speaker": "solago",
          "expression": "angry",
          "text": "¡CHUPAME BIEN LA PIJA!"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "Maxi, una cosa..."
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "¿Qué pasó, Papasito?"
        },
        {
          "speaker": "papasito",
          "expression": "annoyed",
          "text": "¿Y lo de mi historial?"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "¿El de la transferencia?"
        },
        {
          "speaker": "papasito",
          "expression": "angry",
          "text": "¡LO VIERON TODOS!"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Y... me basé en algo que ya había pasado."
        },
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "¡JAJAJAJA! ¡NOOO!"
        },
        {
          "speaker": "solago",
          "expression": "happy",
          "text": "¡JAJAJA! ¡LO MANDÓ AL FRENTE HASTA EN EL JUEGO!"
        },
        {
          "speaker": "papasito",
          "expression": "tired",
          "text": "Ya van a empezar otra vez..."
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "warrior",
          "expression": "neutral",
          "text": "Che, Maxi, ¿y por qué terminé en Conan?"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Ah, eso fue el bot. Le puse Jujuy y entendió Bolivia."
        },
        {
          "speaker": "warrior",
          "expression": "angry",
          "text": "¡Pero Jujuy es Argentina!"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Y sí, ya sé. Pero cuando vi lo que hizo, lo dejé."
        },
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "¡JAJAJA! ¡ENCIMA VIO EL ERROR Y NI LO ARREGLÓ!"
        },
        {
          "speaker": "warrior",
          "expression": "angry",
          "text": "¡Sos un culiao!"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Igual no te quejes, había Loto Amarillo y todo."
        },
        {
          "speaker": "solago",
          "expression": "happy",
          "text": "¡JAJAJA! ¡HASTA EL PROGRAMADOR LE CONSIGUIÓ LA FALOPA!"
        }
      ]
    },
    {
      "type": "dialogue",
      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Bueno, pará. ¿Y Jhony? ¿Lo dejaste atrapado en Project?"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "¿A Jhony? Lo dejé en Project. Con las horas que tiene, estaba más cómodo ahí que acá."
        },
        {
          "speaker": "solago",
          "expression": "happy",
          "text": "¡JAJAJA! ¡SE QUEDÓ JUGANDO SOLO!"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "Le mandé una invitación. Me puteó y siguió jugando."
        },
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "JAJAJA. Ese es Jhony."
        },
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "¿Y Papafrita?"
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "..."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "..."
        },
        {
          "speaker": "solago",
          "expression": "neutral",
          "text": "..."
        },
        {
          "speaker": "warrior",
          "expression": "neutral",
          "text": "..."
        },
        {
          "speaker": "maxi",
          "expression": "neutral",
          "text": "A ese lo mandé al Monster Hunter y le corté el micrófono."
        }
      ]
    },
