      "lines": [
        {
          "speaker": "maxi-negro",
          "expression": "happy",
          "text": "¡AL FIN, PELOTUDOS! ¡VOLVIMOS!"
        },
        {
          "speaker": "solago",
          "expression": "tired",
          "text": "¡LA CONCHA DE SU MADRE, QUÉ JUEGO DE MIERDA!"
        },
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "¿Ya estamos en el Discord?"
        },
        {
          "speaker": "maxi-negro",
          "expression": "surprised",
          "text": "¡PAPASITO! ¿SEGUÍS VIVO?"
        },
        {
          "speaker": "papasito",
          "expression": "neutral",
          "text": "Sí, pues. Te estoy hablando."
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Bueno, bárbaro. Pensé que te habíamos perdido."
        },
        {
          "speaker": "solago",
          "expression": "neutral",
          "text": "Che, pará. ¿Y Maxi?"
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Ni idea. A ese hijo de puta no lo encontramos en ningún lado."
        },
        {
          "speaker": "warrior",
          "expression": "surprised",
          "text": "¡¿Y DÓNDE ESTÁ?!"
        },
        {
          "speaker": "maxi-negro",
          "expression": "neutral",
          "text": "Qué sé yo. Capaz ni entró al juego."
        }
      ],
      "layout": "stage"
